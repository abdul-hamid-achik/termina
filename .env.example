# ── Local secrets via tvault (recommended) ────────────────────────
# Instead of a plaintext .env, store these in tvault (keyed by the SAME names
# below) and inject them per-process — nothing on disk, nothing in shell history:
#   tvault projects create termina-local && tvault use termina-local
#   tvault import .env                 # or: tvault set NUXT_SESSION_PASSWORD …
#   tvault -p termina-local run -- bun run dev   # dev server with secrets injected
# Prod secrets (Vercel env vars) live in the separate `termina` tvault project.
# The plain .env below still works for quick local setup (copy to .env and
# fill in).

# Database (Neon in prod; local Postgres via docker-compose for dev)
DATABASE_URL=postgresql://termina:termina@localhost:5433/termina
NUXT_DATABASE_URL=postgresql://termina:termina@localhost:5433/termina

# Auth — session secret must be at least 32 characters
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-at-least-32-chars

# OAuth — register apps at GitHub/Discord developer portals
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=

# ── All-Vercel realtime + workflow (Ably + Vercel Workflow) ───────
# Ably API key — mints per-player realtime tokens (server/utils/ablyToken.ts)
# and publishes cycle_state over REST from the workflow tick
# (server/utils/ablyRest.ts). Format "keyName:secret", from an Ably app.
ABLY_API_KEY=

# Gates POST /api/game/start-workflow (an internal, non-session-authed
# trigger meant to be called server-side, not from a browser).
WORKFLOW_START_KEY=

# API origin override — a leftover of a Vercel(www) + DigitalOcean(api) split
# deploy that no longer exists (all-Vercel runs same-origin). Leave empty
# unless a future deploy ever splits origins again.
NUXT_PUBLIC_API_URL=

# CORS allow-list for /api/: comma-separated browser Origins permitted
# credentialed cross-origin access. Empty = same-origin requests only (the
# all-Vercel default — there is no separate API origin to allow-list for).
NUXT_CORS_ALLOWED_ORIGINS=

# Server bind (useful for Docker/local)
HOST=0.0.0.0
PORT=3000

# Dev/e2e test hooks — NEVER set in production. Bypasses auth + seeds games.
# TERMINA_TEST_HOOKS=1
# TERMINA_DISABLE_RATE_LIMIT=1
# TERMINA_TEST_FAST_GAME=8
